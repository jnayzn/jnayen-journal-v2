{
  "name": "jnayen-journal-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Jnayen Trading Journal — MT5 trading journal monorepo (no AI variant).",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "pnpm -r --parallel run lint",
    "build": "pnpm -r run build",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "db:push": "pnpm --filter @workspace/db run push",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/trading-journal run dev",
    "seed": "pnpm --filter @workspace/api-server run seed"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
